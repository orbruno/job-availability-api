{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://job-availability.local/schemas/availability-fixture-set-v1.schema.json",
  "title": "Job Availability Fixture Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "fixture_set_schema_version",
    "fixture_type",
    "contract_version",
    "frozen_clock",
    "source_contracts",
    "cases"
  ],
  "properties": {
    "$schema": {
      "const": "./availability-fixture-set-v1.schema.json"
    },
    "fixture_set_schema_version": {
      "const": 1
    },
    "fixture_type": {
      "enum": [
        "source_identity",
        "observation_classification",
        "availability_state",
        "run_state",
        "boundary_security",
        "persisted_compatibility"
      ]
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "frozen_clock": {
      "const": "2026-08-27T00:00:00Z"
    },
    "source_contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceContract"
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "sourceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "project_path"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "project_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expectation",
        "requirements",
        "source_refs",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "minLength": 3,
          "maxLength": 128
        },
        "expectation": {
          "enum": ["parity", "correction", "new_contract"]
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^JA-(?:FR|NFR|AC)-[0-9]{2}$"
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 256
          }
        },
        "input": {
          "type": "object"
        },
        "expected": {
          "type": "object"
        },
        "legacy_observed": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectation": {
                "const": "correction"
              }
            },
            "required": ["expectation"]
          },
          "then": {
            "properties": {
              "legacy_observed": {
                "type": "object"
              }
            },
            "required": ["legacy_observed"]
          },
          "else": {
            "properties": {
              "legacy_observed": false
            }
          }
        }
      ]
    }
  }
}
