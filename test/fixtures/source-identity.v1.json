    {
      "id": "identity.indeed-native-route-variants",
      "expectation": "parity",
      "requirements": ["JA-FR-07", "JA-AC-04"],
      "source_refs": [
        "SPEC-018#Testing design: source variants",
        "PYTHON-BASELINE-SOURCE-IDENTITY#source_identity"
      ],
      "input": {
        "urls": [
          "https://de.indeed.com/viewjob?jk=ABC123&utm_source=mail",
          "https://de.indeed.com/rc/clk?from=vj&jk=abc123"
        ]
      },
      "expected": {
        "canonical_urls": [
          "de.indeed.com/__job__/ind:abc123",
          "de.indeed.com/__job__/ind:abc123"
        ],
        "native_job_ids": ["ind:abc123", "ind:abc123"],
        "equivalent": true
      }
    },
    {
      "id": "identity.stepstone-native-id",
      "expectation": "parity",
      "requirements": ["JA-FR-07", "JA-AC-04"],
      "source_refs": [
        "SPEC-018#Testing design: native IDs",
        "PYTHON-BASELINE-SOURCE-IDENTITY#_native_job_id"
      ],
      "input": {
        "urls": [
          "https://www.stepstone.de/stellenangebote--Data-Engineer-Berlin-Acme-12345678.html?cid=mail"
        ]
      },
      "expected": {
        "canonical_urls": ["stepstone.de/__job__/ss:12345678"],
        "native_job_ids": ["ss:12345678"],
        "equivalent": true
      }
    },
    {
