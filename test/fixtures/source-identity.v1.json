    {
      "id": "identity-non-default-port-significant",
      "expectation": "correction",
      "requirements": ["JA-FR-07", "JA-AC-04"],
      "source_refs": [
        "SPEC-018#Testing design: ports",
        "PYTHON-BASELINE-SOURCE-IDENTITY#source_identity"
      ],
      "input": {
        "urls": [
          "https://jobs.example.com:8443/openings/data-engineer",
          "https://jobs.example.com/openings/data-engineer"
        ]
      },
      "expected": {
        "canonical_urls": [
          "jobs.example.com:8443/openings/data-engineer",
          "jobs.example.com/openings/data-engineer"
        ],
        "native_job_ids": [null, null],
        "equivalent": false
      },
      "legacy_observed": {
        "canonical_urls": [
          "jobs.example.com/openings/data-engineer",
          "jobs.example.com/openings/data-engineer"
        ],
        "equivalent": true,
        "defect": "The non-default port was discarded and two endpoints were merged."
      }
    },
    {
      "id": "identity-path-case-significant",
      "expectation": "correction",
      "requirements": ["JA-FR-07", "JA-AC-04"],
      "source_refs": [
        "SPEC-018#Testing design: case-sensitive paths",
        "PYTHON-BASELINE-SOURCE-IDENTITY#source_identity"
      ],
      "input": {
        "urls": [
          "https://jobs.example.com/Jobs/Data-Engineer",
          "https://jobs.example.com/jobs/data-engineer"
        ]
      },
      "expected": {
        "canonical_urls": [
          "jobs.example.com/Jobs/Data-Engineer",
          "jobs.example.com/jobs/data-engineer"
        ],
        "native_job_ids": [null, null],
        "equivalent": false
      },
      "legacy_observed": {
        "canonical_urls": [
          "jobs.example.com/jobs/data-engineer",
          "jobs.example.com/jobs/data-engineer"
        ],
        "equivalent": true,
        "defect": "The generic route path was lowercased and distinct paths were merged."
      }
    },
    {
      "id": "identity-unicode-idn-punycode-converge",
      "expectation": "correction",
      "requirements": ["JA-FR-07", "JA-AC-04"],
      "source_refs": [
        "SPEC-018#Testing design: Unicode or IDN hosts",
        "PYTHON-BASELINE-SOURCE-IDENTITY#source_identity"
      ],
      "input": {
        "urls": [
          "https://bücher.example/Stelle?position=1",
          "https://xn--bcher-kva.example/Stelle?position=1"
        ]
      },
      "expected": {
        "canonical_urls": [
          "xn--bcher-kva.example/Stelle?position=1",
          "xn--bcher-kva.example/Stelle?position=1"
        ],
        "native_job_ids": [null, null],
        "equivalent": true
      },
      "legacy_observed": {
        "canonical_urls": [
          "bücher.example/stelle?position=1",
          "xn--bcher-kva.example/stelle?position=1"
        ],
        "equivalent": false,
        "defect": "The Unicode hostname was not converted to its ASCII IDN form, so equivalent hosts remained distinct."
      }
    }
