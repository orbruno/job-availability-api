# Direct Node.js execution. Do not place the service token in this file.
JOB_AVAILABILITY_HOST=127.0.0.1
JOB_AVAILABILITY_PORT=5002
JOB_AVAILABILITY_DATA_ROOT=/absolute/path/to/isolated/job-availability-data
JOB_AVAILABILITY_TOKEN_FILE=/absolute/path/to/mode-0600/job-availability-token
JOB_AVAILABILITY_OWNER_KEY=local-operator
JOB_AVAILABILITY_HOST_SPACING_MS=1000

# Docker Compose reads this path during variable interpolation and bind-mounts the protected file.
JOB_AVAILABILITY_COMPOSE_TOKEN_FILE=/absolute/path/to/mode-0600/job-availability-token
